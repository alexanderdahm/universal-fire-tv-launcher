<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon (API 26+). The background is the configured accent colour,
    generated from APP_ICON_COLOR; API 21-25 devices use the PNGs that the
    build renders into mipmap-*dpi.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_icon_color" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
